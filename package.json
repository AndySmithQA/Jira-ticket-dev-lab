{
  "name": "jira-ticket-development-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A complete Jira-to-pull-request training lab with a local Jira-compatible MCP server.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "jira": "node dist/training-jira/server.js",
    "test": "vitest run --exclude \"src/acceptance/**\"",
    "test:acceptance": "vitest run src/acceptance",
    "test:all": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
