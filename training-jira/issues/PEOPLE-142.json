    },
    "summary": "Retain employee records when an administrator deletes an account",
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": { "level": 2 },
          "content": [{ "type": "text", "text": "User story" }]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a People Operations administrator, I want deleted employees to be retained as inactive records so that employment history remains available for audit and support."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": { "level": 2 },
          "content": [{ "type": "text", "text": "Background" }]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The current DELETE endpoint permanently removes an employee from the in-memory repository. This means administrators lose access to the historical record."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": { "level": 2 },
          "content": [{ "type": "text", "text": "Acceptance criteria" }]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{ "type": "text", "text": "AC1: Given an active employee, when an administrator deletes that employee, then the endpoint returns 204 and the stored record has active set to false." }]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{ "type": "text", "text": "AC2: Inactive employees do not appear in GET /employees, including filtered searches." }]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{ "type": "text", "text": "AC3: GET /employees/:id returns 404 for an inactive employee." }]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{ "type": "text", "text": "AC4: Administrators can still see inactive employees in GET /admin/employees and GET /admin/employees/:id." }]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{ "type": "text", "text": "AC5: Deleting an employee who is already inactive is idempotent and returns 204." }]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": { "level": 2 },
          "content": [{ "type": "text", "text": "Out of scope" }]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reactivating an employee." }] }]
            },
            {
              "type": "listItem",
              "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Database persistence or schema migrations." }] }]
            },
            {
              "type": "listItem",
              "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Changing email uniqueness rules." }] }]
            }
          ]
        }
      ]
    },
